#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$SCRIPT_DIR/lib/common.sh" ]; then
  ROOT_DIR=$SCRIPT_DIR
else
  ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
fi
# shellcheck source=lib/common.sh
. "$ROOT_DIR/lib/common.sh"
CATALOG_FILE="$ROOT_DIR/catalog/official-apps.env"
[ -r "$CATALOG_FILE" ] || fail "official app catalog is missing: $CATALOG_FILE"
# shellcheck source=catalog/official-apps.env
. "$CATALOG_FILE"

VERSION='0.4.0'
ENV_FILE=''
CURRENT_ENV_FILE=''
BACKUP_DIR=''
LOCK_FILE=''
FORCE=false
LINES=100
FOLLOW=false
DOCKER_LOGS=false
PLAN_APPS=''
EXISTING_ACTION='ask'
YES=false

usage() {
  cat <<'TEXT'
FrappeUp CLI

Usage:
  frappeup init --profile development|production [--env-file PATH] [--force]
  frappeup catalog list
  frappeup plan --env-file PATH
  frappeup lock --env-file PATH [--output PATH] [--force]
  frappeup workspace --env-file PATH [--lock-file PATH] [--force]
  frappeup install --env-file PATH [--existing keep]
  frappeup app prepare --current-env-file CURRENT --env-file TARGET
  frappeup app plan --current-env-file CURRENT --env-file TARGET
  frappeup app apply --current-env-file CURRENT --env-file TARGET [--yes]
  frappeup backup --env-file PATH
  frappeup backup verify --backup-dir PATH
  frappeup restore --env-file PROFILE --backup-dir PATH [--yes]
  frappeup credentials --env-file PATH
  frappeup status --env-file PATH
  frappeup logs --env-file PATH [--docker] [--lines N] [--follow]
  frappeup doctor [--env-file PATH]
  frappeup version
TEXT
}

parse_common() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --env-file) [ "$#" -gt 1 ] || fail '--env-file needs a path'; ENV_FILE=$2; shift 2 ;;
      --current-env-file) [ "$#" -gt 1 ] || fail '--current-env-file needs a path'; CURRENT_ENV_FILE=$2; shift 2 ;;
      --backup-dir) [ "$#" -gt 1 ] || fail '--backup-dir needs a path'; BACKUP_DIR=$2; shift 2 ;;
      --lock-file) [ "$#" -gt 1 ] || fail '--lock-file needs a path'; LOCK_FILE=$2; shift 2 ;;
      --output) [ "$#" -gt 1 ] || fail '--output needs a path'; LOCK_FILE=$2; shift 2 ;;
      --force) FORCE=true; shift ;;
      --yes) YES=true; shift ;;
      --lines) [ "$#" -gt 1 ] || fail '--lines needs a number'; LINES=$2; shift 2 ;;
      --follow) FOLLOW=true; shift ;;
      --docker) DOCKER_LOGS=true; shift ;;
      --existing) [ "$#" -gt 1 ] || fail '--existing needs keep'; [ "$2" = keep ] || fail '--existing supports keep only'; EXISTING_ACTION=keep; shift 2 ;;
      *) fail "unknown option: $1" ;;
    esac
  done
}

load_profile() {
  [ -n "$ENV_FILE" ] || fail '--env-file is required'
  [ -r "$ENV_FILE" ] || fail "cannot read profile: $ENV_FILE"
  ENV_FILE=$(CDPATH= cd -- "$(dirname -- "$ENV_FILE")" && pwd)/$(basename -- "$ENV_FILE")
  ENV_DIR=$(dirname -- "$ENV_FILE")
  # Profile files are shell-compatible KEY=VALUE files owned by the local user.
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
  PROFILE=${PROFILE:-development}
  PROJECT_NAME=${PROJECT_NAME:-frappeup}
  SITE_NAME=${SITE_NAME:-site.localhost}
  FRAPPE_REPOSITORY=${FRAPPE_REPOSITORY:-https://github.com/frappe/frappe}
  FRAPPE_REF=${FRAPPE_REF:-version-16}
  FRAPPE_REF_KIND=${FRAPPE_REF_KIND:-branch}
  FRAPPE_DOCKER_REPOSITORY=${FRAPPE_DOCKER_REPOSITORY:-https://github.com/frappe/frappe_docker}
  FRAPPE_DOCKER_REF=${FRAPPE_DOCKER_REF:-main}
  FRAPPE_DOCKER_REF_KIND=${FRAPPE_DOCKER_REF_KIND:-branch}
  FRAPPE_MAJOR=${FRAPPE_MAJOR:-16}
  INSTALL_APPS=${INSTALL_APPS:-}
  if [ -n "${WORKSPACE_DIR:-}" ]; then
    case "$WORKSPACE_DIR" in /*) :;; *) WORKSPACE_DIR="$ENV_DIR/$WORKSPACE_DIR";; esac
  elif [ -e "$ENV_DIR/.frappe1tap/workspaces/$PROJECT_NAME" ]; then
    WORKSPACE_DIR="$ENV_DIR/.frappe1tap/workspaces/$PROJECT_NAME"
  else
    WORKSPACE_DIR="$ENV_DIR/.frappeup/workspaces/$PROJECT_NAME"
  fi
  case "$WORKSPACE_DIR" in */.frappe1tap/workspaces/*) LOG_DIR="$ENV_DIR/.frappe1tap/logs";; *) LOG_DIR="$ENV_DIR/.frappeup/logs";; esac
  case "$PROFILE" in development|production) :;; *) fail 'PROFILE must be development or production';; esac
  valid_identifier "$PROJECT_NAME" || fail 'PROJECT_NAME may contain only letters, numbers, _ and -'
  valid_site "$SITE_NAME" || fail 'SITE_NAME may contain only letters, numbers, dots, and -'
  case "$FRAPPE_MAJOR" in *[!0-9]*|'') fail 'FRAPPE_MAJOR must be a positive integer';; esac
  [ "$FRAPPE_MAJOR" -gt 0 ] || fail 'FRAPPE_MAJOR must be a positive integer'
  if [ -n "${CUSTOM_APPS_FILE:-}" ]; then
    case "$CUSTOM_APPS_FILE" in /*) :;; *) CUSTOM_APPS_FILE="$ENV_DIR/$CUSTOM_APPS_FILE";; esac
    [ -r "$CUSTOM_APPS_FILE" ] || fail "cannot read CUSTOM_APPS_FILE: $CUSTOM_APPS_FILE"
    # shellcheck disable=SC1090
    . "$CUSTOM_APPS_FILE"
    APP_IDS="$APP_IDS ${CUSTOM_APP_IDS:-}"
  fi
}

app_field() {
  valid_app_id "$1" || fail "invalid app id: $1"
  case "$2" in DISPLAY_NAME|REPOSITORY|REF|REF_KIND|APP_NAME|REQUIRES|MAJORS) :;; *) fail 'invalid catalog field';; esac
  eval "printf '%s' \"\${APP_$1_$2-}\""
}

effective_ref() {
  id=$1
  key=$(upper "$id")
  eval "override=\${APP_${key}_REF-}"
  if [ -n "${override:-}" ]; then printf '%s' "$override"; else app_field "$id" REF; fi
}

effective_ref_kind() {
  id=$1
  key=$(upper "$id")
  eval "override=\${APP_${key}_REF_KIND-}"
  if [ -n "${override:-}" ]; then printf '%s' "$override"; else app_field "$id" REF_KIND; fi
}

is_supported() { case " $(app_field "$1" MAJORS) " in *" $FRAPPE_MAJOR "*) return 0;; *) return 1;; esac; }
contains_word() { case " $1 " in *" $2 "*) return 0;; *) return 1;; esac; }
resolve_app() {
  valid_app_id "$1" || fail "invalid app id: $1"
  [ -n "$(app_field "$1" REPOSITORY)" ] || fail "unknown app: $1; add it to CUSTOM_APPS_FILE"
  is_supported "$1" || fail "$1 does not declare support for Frappe $FRAPPE_MAJOR"
  eval "state=\${RESOLVE_$1-}"
  case "${state:-}" in done) return;; visiting) fail "cyclic dependency at app $1";; esac
  eval "RESOLVE_$1=visiting"
  for dependency in $(app_field "$1" REQUIRES); do resolve_app "$dependency"; done
  PLAN_APPS="$PLAN_APPS $1"
  eval "RESOLVE_$1=done"
}

build_plan() {
  PLAN_APPS=''
  for id in $(printf '%s' "$INSTALL_APPS" | tr ',' ' '); do [ -z "$id" ] || resolve_app "$id"; done
  PLAN_APPS=$(printf '%s\n' "$PLAN_APPS" | awk '{$1=$1; print}')
}

plan_checksum() {
  {
    printf 'project=%s\nsite=%s\nfrappe=%s@%s|%s\nfrappe_docker=%s@%s|%s\nmajor=%s\n' "$PROJECT_NAME" "$SITE_NAME" "$FRAPPE_REPOSITORY" "$FRAPPE_REF" "$FRAPPE_REF_KIND" "$FRAPPE_DOCKER_REPOSITORY" "$FRAPPE_DOCKER_REF" "$FRAPPE_DOCKER_REF_KIND" "$FRAPPE_MAJOR"
    for id in $PLAN_APPS; do printf 'app=%s|%s|%s|%s|%s\n' "$id" "$(app_field "$id" REPOSITORY)" "$(effective_ref "$id")" "$(effective_ref_kind "$id")" "$(app_field "$id" APP_NAME)"; done
  } | sha256
}

legacy_plan_checksum() {
  {
    printf 'project=%s\nsite=%s\nfrappe=%s@%s\nfrappe_docker=%s@%s\nmajor=%s\n' "$PROJECT_NAME" "$SITE_NAME" "$FRAPPE_REPOSITORY" "$FRAPPE_REF" "$FRAPPE_DOCKER_REPOSITORY" "$FRAPPE_DOCKER_REF" "$FRAPPE_MAJOR"
    for id in $PLAN_APPS; do printf 'app=%s|%s|%s|%s\n' "$id" "$(app_field "$id" REPOSITORY)" "$(effective_ref "$id")" "$(app_field "$id" APP_NAME)"; done
  } | sha256
}

write_env_var() { printf "%s='%s'\n" "$1" "$(quote_env "$2")"; }
resolve_commit() {
  repository=$1 ref=$2 kind=$3
  require_command git
  case "$kind" in commit) case "$ref" in *[!0-9a-fA-F]*|'') fail 'commit ref must be a hexadecimal hash';; esac; [ "${#ref}" -eq 40 ] || fail 'commit ref must be a 40-character hash'; printf '%s' "$ref"; return;; branch) refs="$ref refs/heads/$ref";; tag) refs="$ref refs/tags/$ref refs/tags/$ref^{}";; *) fail "invalid ref kind $kind for $repository";; esac
  output=$(GIT_TERMINAL_PROMPT=0 git ls-remote "$repository" $refs 2>&1) || fail "resolve $repository @ $ref: $output"
  if [ "$kind" = tag ]; then commit=$(printf '%s\n' "$output" | awk -v r="refs/tags/$ref^{}" '$2==r {print $1; exit}'); else commit=''; fi
  [ -n "$commit" ] || commit=$(printf '%s\n' "$output" | awk -v r="$ref" -v h="refs/heads/$ref" -v t="refs/tags/$ref" '$2==r || $2==h || $2==t {print $1; exit}')
  [ -n "$commit" ] || fail "ref $ref was not found in $repository"
  printf '%s' "$commit"
}

load_lock() {
  [ -n "$LOCK_FILE" ] || LOCK_FILE="$ENV_FILE.lock.env"
  [ -r "$LOCK_FILE" ] || fail "cannot read lock file: $LOCK_FILE"
  # shellcheck disable=SC1090
  . "$LOCK_FILE"
  case "${LOCK_SCHEMA:-}" in
    1)
      [ "$LOCK_PLAN_SHA256" = "$(legacy_plan_checksum)" ] || fail 'lock file does not match profile; run lock and workspace again'
      [ "$FRAPPE_REF_KIND" = branch ] && [ "$FRAPPE_DOCKER_REF_KIND" = branch ] && [ -z "${CUSTOM_APPS_FILE:-}" ] || fail 'legacy lock cannot verify ref kinds; run lock and workspace again'
      for id in $PLAN_APPS; do [ "$(effective_ref_kind "$id")" = "$(app_field "$id" REF_KIND)" ] || fail 'legacy lock cannot verify app ref kind; run lock and workspace again'; done
      ;;
    2)
      [ "$LOCK_PLAN_SHA256" = "$(plan_checksum)" ] || fail 'lock file does not match profile; run lock and workspace again'
      [ "$LOCK_FRAPPE_REF_KIND" = "$FRAPPE_REF_KIND" ] && [ "$LOCK_FRAPPE_DOCKER_REF_KIND" = "$FRAPPE_DOCKER_REF_KIND" ] || fail 'lock ref kind does not match profile'
      for id in $PLAN_APPS; do eval "locked_kind=\${LOCK_APP_${id}_REF_KIND-}"; [ "$locked_kind" = "$(effective_ref_kind "$id")" ] || fail "lock ref kind does not match app $id"; done
      ;;
    *) fail 'unsupported lock file; run lock again' ;;
  esac
}

snapshot() {
  repository=$1 commit=$2 destination=$3
  GIT_TERMINAL_PROMPT=0 git clone --no-checkout --filter=blob:none "$repository" "$destination" || fail "clone failed: $repository"
  GIT_TERMINAL_PROMPT=0 git -C "$destination" fetch --filter=blob:none origin "$commit" || fail "fetch failed: $repository@$commit"
  git -C "$destination" checkout --detach "$commit" || fail "checkout failed: $repository@$commit"
  git -C "$destination" branch -f frappeup-lock "$commit" >/dev/null
}

workspace_command() {
  load_profile; build_plan; load_lock
  if [ "$FORCE" = true ] && [ -e "$WORKSPACE_DIR" ]; then
    if command -v docker >/dev/null 2>&1 && { [ -n "$(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT_NAME" 2>/dev/null)" ] || [ -n "$(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT_NAME" 2>/dev/null)" ]; }; then
      fail "project $PROJECT_NAME has Docker resources; refusing to replace its workspace"
    fi
    rm -rf "$WORKSPACE_DIR"
  fi
  [ ! -e "$WORKSPACE_DIR" ] || fail "workspace exists: $WORKSPACE_DIR; use --force to replace it"
  temp="$WORKSPACE_DIR.tmp.$$"
  trap 'rm -rf "$temp"' EXIT HUP INT TERM
  mkdir -p "$temp"
  snapshot "$LOCK_FRAPPE_DOCKER_REPOSITORY" "$LOCK_FRAPPE_DOCKER_COMMIT" "$temp/runtime"
  mkdir -p "$temp/runtime/sources/apps"
  snapshot "$LOCK_FRAPPE_REPOSITORY" "$LOCK_FRAPPE_COMMIT" "$temp/runtime/sources/frappe"
  for id in $PLAN_APPS; do
    eval "repo=\${LOCK_APP_${id}_REPOSITORY-}"; eval "commit=\${LOCK_APP_${id}_COMMIT-}"
    [ -n "${repo:-}" ] && [ -n "${commit:-}" ] || fail "lock file lacks app $id"
    snapshot "$repo" "$commit" "$temp/runtime/sources/apps/$id"
  done
  containerfile="$temp/runtime/images/custom/Containerfile"
  [ "$(grep -c '^ARG FRAPPE_BRANCH=' "$containerfile")" -eq 1 ] || fail 'unsupported Frappe Docker Containerfile: FRAPPE_BRANCH is not unique'
  [ "$(grep -c '^ARG FRAPPE_PATH=' "$containerfile")" -eq 1 ] || fail 'unsupported Frappe Docker Containerfile: FRAPPE_PATH is not unique'
  awk 'BEGIN {added=0} $0=="USER frappe" && !added {print; print ""; print "# Commit-locked sources generated by FrappeUp."; print "COPY --chown=frappe:0 sources /opt/frappe/sources"; added=1; next} {print}' "$containerfile" | sed 's|^ARG FRAPPE_BRANCH=.*|ARG FRAPPE_BRANCH=frappeup-lock|; s|^ARG FRAPPE_PATH=.*|ARG FRAPPE_PATH=file:///opt/frappe/sources/frappe|' > "$containerfile.tmp"
  mv "$containerfile.tmp" "$containerfile"
  {
    printf '[\n'; first=true
    for id in $PLAN_APPS; do
      if [ "$first" = true ]; then first=false; else printf ',\n'; fi
      printf '  {"url":"file:///opt/frappe/sources/apps/%s","branch":"frappeup-lock"}' "$id"
    done
    printf '\n]\n'
  } > "$temp/runtime/apps.json"
  umask 077
  { printf '# generated private runtime secrets\n'; printf 'ADMIN_PASSWORD='; dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64 | tr -d '\n'; printf '\nDB_PASSWORD='; dd if=/dev/urandom bs=32 count=1 2>/dev/null | base64 | tr -d '\n'; printf '\n'; } > "$temp/credentials.env"
  write_env_var WORKSPACE_PLAN_SHA256 "$LOCK_PLAN_SHA256" > "$temp/workspace.env"
  write_env_var IMAGE "frappeup/$PROJECT_NAME" >> "$temp/workspace.env"
  write_env_var TAG "$(printf '%s' "$LOCK_PLAN_SHA256" | cut -c1-12)" >> "$temp/workspace.env"
  mv "$temp" "$WORKSPACE_DIR"; trap - EXIT HUP INT TERM
  log_event 'workspace.completed'
  printf 'Created workspace %s\n' "$WORKSPACE_DIR"
}

compose_at() (
  workspace=$1; shift
  runtime="$workspace/runtime"
  if [ -r "$runtime/.frappeup.env" ]; then runtime_env="$runtime/.frappeup.env"; else runtime_env="$runtime/.frappe1tap.env"; fi
  if [ -r "$runtime/frappeup.create-site.yaml" ]; then site_compose="$runtime/frappeup.create-site.yaml"; else site_compose="$runtime/frappe1tap.create-site.yaml"; fi
  if [ -r "$site_compose" ] && [ -n "${COMPOSE_EXTRA_FILE:-}" ]; then
    docker compose --env-file "$runtime_env" --env-file "$workspace/credentials.env" -p "$PROJECT_NAME" -f "$runtime/compose.yaml" -f "$runtime/overrides/compose.mariadb.yaml" -f "$runtime/overrides/compose.redis.yaml" -f "$runtime/overrides/compose.noproxy.yaml" -f "$site_compose" -f "$COMPOSE_EXTRA_FILE" "$@"
  elif [ -r "$site_compose" ]; then
    docker compose --env-file "$runtime_env" --env-file "$workspace/credentials.env" -p "$PROJECT_NAME" -f "$runtime/compose.yaml" -f "$runtime/overrides/compose.mariadb.yaml" -f "$runtime/overrides/compose.redis.yaml" -f "$runtime/overrides/compose.noproxy.yaml" -f "$site_compose" "$@"
  elif [ -n "${COMPOSE_EXTRA_FILE:-}" ]; then
    docker compose --env-file "$runtime_env" --env-file "$workspace/credentials.env" -p "$PROJECT_NAME" -f "$runtime/compose.yaml" -f "$runtime/overrides/compose.mariadb.yaml" -f "$runtime/overrides/compose.redis.yaml" -f "$runtime/overrides/compose.noproxy.yaml" -f "$COMPOSE_EXTRA_FILE" "$@"
  else
    docker compose --env-file "$runtime_env" --env-file "$workspace/credentials.env" -p "$PROJECT_NAME" -f "$runtime/compose.yaml" -f "$runtime/overrides/compose.mariadb.yaml" -f "$runtime/overrides/compose.redis.yaml" -f "$runtime/overrides/compose.noproxy.yaml" "$@"
  fi
)
compose_runtime() { compose_at "$WORKSPACE_DIR" "$@"; }

project_resources() {
  container_ids=$(docker ps -aq --filter "label=com.docker.compose.project=$PROJECT_NAME") || fail 'cannot inspect Docker containers'
  volume_names=$(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT_NAME") || fail 'cannot inspect Docker volumes'
  [ -n "$container_ids" ] || [ -n "$volume_names" ]
}

show_project_resources() {
  printf 'Existing Docker project: %s\n' "$PROJECT_NAME"
  if [ -n "$container_ids" ]; then docker ps -a --filter "label=com.docker.compose.project=$PROJECT_NAME" --format '  container: {{.Names}} ({{.Status}})'; fi
  if [ -n "$volume_names" ]; then docker volume ls --filter "label=com.docker.compose.project=$PROJECT_NAME" --format '  volume: {{.Name}}'; fi
}

choose_existing_action() {
  [ "$EXISTING_ACTION" = keep ] && { printf 'Keeping existing data and deployment; no changes made.\n'; return 1; }
  if [ ! -t 0 ]; then printf 'Keeping existing data in non-interactive mode; no changes made.\n'; return 1; fi
  printf 'Choose [K]eep data or [R]eset after a verified backup (default K): ' >&2
  IFS= read -r answer || answer=''
  case "$answer" in r|R|reset|RESET) return 0;; ''|k|K|keep|KEEP) printf 'Keeping existing data and deployment; no changes made.\n'; return 1;; *) fail 'invalid choice; no changes made';; esac
}

backup_site() {
  backup_workspace=$1 backup_purpose=$2
  backend_id=$(compose_at "$backup_workspace" ps -q backend 2>/dev/null) || backend_id=''
  [ -n "$backend_id" ] || fail 'backup requires a running backend; no data was changed'
  compose_at "$backup_workspace" exec -T backend bench --site "$SITE_NAME" list-apps >/dev/null || fail "site $SITE_NAME is not available for backup; no data was changed"
  stamp=$(date -u '+%Y%m%d_%H%M%S')
  backup_dir="$ENV_DIR/.frappeup/backups/$PROJECT_NAME/$backup_purpose-$stamp-$$"
  # Frappe expects private/backups to contain files only; a directory there
  # makes its next backup fail in delete_temp_backups().
  container_backup="/home/frappe/frappe-bench/sites/.frappeup-backups/$SITE_NAME/$backup_purpose-$stamp-$$"
  umask 077
  mkdir -p "$backup_dir"
  compose_at "$backup_workspace" exec -T backend bench --site "$SITE_NAME" backup --with-files --compress --backup-path "$container_backup" || fail "backup failed; no data was changed (partial files: $backup_dir)"
  docker cp "$backend_id:$container_backup/." "$backup_dir" || fail "backup export failed; no data was changed (partial files: $backup_dir)"
  database_archive=$(find "$backup_dir" -maxdepth 1 -type f -name '*-database*.sql.gz' -size +0c -print -quit)
  public_archive=$(find "$backup_dir" -maxdepth 1 -type f -name '*-files.tgz' ! -name '*-private-files.tgz' -size +0c -print -quit)
  private_archive=$(find "$backup_dir" -maxdepth 1 -type f -name '*-private-files.tgz' -size +0c -print -quit)
  config_backup=$(find "$backup_dir" -maxdepth 1 -type f -name '*-site_config_backup.json' -size +0c -print -quit)
  [ -n "$database_archive" ] && [ -n "$public_archive" ] && [ -n "$private_archive" ] && [ -n "$config_backup" ] || fail 'backup is incomplete; no data was changed'
  gzip -t "$database_archive" || fail 'database archive is corrupt; no data was changed'
  tar -tzf "$public_archive" >/dev/null || fail 'public files archive is corrupt; no data was changed'
  tar -tzf "$private_archive" >/dev/null || fail 'private files archive is corrupt; no data was changed'
  {
    for artifact in "$database_archive" "$public_archive" "$private_archive" "$config_backup"; do
      printf '%s  %s\n' "$(sha256 < "$artifact")" "$(basename -- "$artifact")"
    done
  } > "$backup_dir/SHA256SUMS"
  {
    write_env_var BACKUP_PROJECT "$PROJECT_NAME"
    write_env_var BACKUP_SITE "$SITE_NAME"
    write_env_var BACKUP_IMAGE "$(docker inspect --format '{{.Config.Image}}' "$backend_id")"
    write_env_var BACKUP_CREATED_UTC "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } > "$backup_dir/manifest.env"
  printf 'Validated backup archives: %s\n' "$backup_dir"
}
backup_before_reset() { backup_site "$WORKSPACE_DIR" reset; }

reset_project() {
  backup_before_reset
  printf 'Type RESET %s to remove its Docker volumes: ' "$PROJECT_NAME" >&2
  IFS= read -r confirmation || confirmation=''
  [ "$confirmation" = "RESET $PROJECT_NAME" ] || { printf 'Reset cancelled; existing data is unchanged.\n'; return 1; }
  compose_runtime down --volumes --remove-orphans
  log_event 'reset.completed'
  printf 'Reset project %s; backup remains at %s\n' "$PROJECT_NAME" "$backup_dir"
}

site_exists() {
  backend_id=$(compose_runtime ps -q backend 2>/dev/null) || return 1
  [ -n "$backend_id" ] || return 1
  expected_image="frappeup/$PROJECT_NAME:$(printf '%s' "$LOCK_PLAN_SHA256" | cut -c1-12)"
  actual_image=$(docker inspect --format '{{.Config.Image}}' "$backend_id" 2>/dev/null) || return 1
  [ "$actual_image" = "$expected_image" ] || fail "project $PROJECT_NAME runs a different locked image; use a new PROJECT_NAME"
  installed=$(compose_runtime exec -T backend bench --site "$SITE_NAME" list-apps 2>/dev/null) || return 1
  for id in $PLAN_APPS; do app=$(app_field "$id" APP_NAME); printf '%s\n' "$installed" | awk '{print $1}' | grep -Fx "$app" >/dev/null || fail "site $SITE_NAME already exists without required app $app; refusing to replace it"; done
  return 0
}

validate_install_workspace() {
  build_plan; load_lock
  runtime="$WORKSPACE_DIR/runtime"
  [ -r "$runtime/images/custom/Containerfile" ] && [ -r "$runtime/apps.json" ] && [ -r "$WORKSPACE_DIR/credentials.env" ] || fail 'workspace is incomplete; run workspace first'
  [ -r "$WORKSPACE_DIR/workspace.env" ] || fail 'workspace metadata is missing; run workspace first'
  . "$WORKSPACE_DIR/workspace.env"
  [ "$WORKSPACE_PLAN_SHA256" = "$LOCK_PLAN_SHA256" ] || fail 'workspace does not match lock; run workspace again'
}

build_runtime_image() {
  image="frappeup/$PROJECT_NAME" tag=$(printf '%s' "$LOCK_PLAN_SHA256" | cut -c1-12)
  docker buildx build --platform linux/amd64 --load --tag "$image:$tag" --file "$runtime/images/custom/Containerfile" --secret "id=apps_json,src=$runtime/apps.json" "$runtime"
  { printf 'CUSTOM_IMAGE=%s\nCUSTOM_TAG=%s\nPULL_POLICY=never\nFRAPPE_SITE_NAME_HEADER=%s\n' "$image" "$tag" "$SITE_NAME"; } > "$runtime/.frappeup.env"
  script="set -e; wait-for-it db:3306 -t 120; bench new-site --mariadb-user-host-login-scope=% --admin-password=\$\$ADMIN_PASSWORD --db-root-username=root --db-root-password=\$\$DB_PASSWORD --set-default $SITE_NAME;"
  for id in $PLAN_APPS; do app=$(app_field "$id" APP_NAME); valid_identifier "$app" || fail "invalid app name: $app"; script="$script bench --site $SITE_NAME install-app $app;"; done
  cat > "$runtime/frappeup.create-site.yaml" <<EOF2
services:
  create-site:
    image: \${CUSTOM_IMAGE}:\${CUSTOM_TAG}
    platform: linux/amd64
    pull_policy: never
    restart: "no"
    volumes:
      - sites:/home/frappe/frappe-bench/sites
    depends_on:
      configurator:
        condition: service_completed_successfully
      db:
        condition: service_healthy
    environment:
      ADMIN_PASSWORD: \${ADMIN_PASSWORD}
      DB_PASSWORD: \${DB_PASSWORD}
    entrypoint: ["bash", "-c"]
    command: ["$script"]
EOF2
  compose_runtime config -q
}

install_command() {
  load_profile
  [ "$PROFILE" = development ] || fail 'production installation is not implemented yet'
  doctor_check
  existing=false
  if project_resources; then
    existing=true
    show_project_resources
    if ! choose_existing_action; then return 0; fi
  fi
  validate_install_workspace
  build_runtime_image
  if [ "$existing" = true ]; then
    if ! reset_project; then return 0; fi
  fi
  compose_runtime up -d
  compose_runtime wait create-site || fail "site creation failed; run: frappeup logs --env-file $ENV_FILE --docker"
  site_exists || fail 'site task exited successfully but site is not available'
  log_event 'install.completed'
  printf 'Installed %s\n' "$SITE_NAME"
  printf 'Sign in as Administrator. Get the initial password with: frappeup credentials --env-file %s\n' "$ENV_FILE"
}

app_prepare() {
  [ -n "$CURRENT_ENV_FILE" ] && [ -n "$ENV_FILE" ] || fail 'app prepare requires --current-env-file and --env-file'
  target_env=$ENV_FILE
  [ ! -e "$target_env" ] || fail "target profile already exists: $target_env"
  ENV_FILE=$CURRENT_ENV_FILE
  load_profile; build_plan
  [ "$PROFILE" = development ] || fail 'app prepare currently supports development profiles only'
  [ -d "$WORKSPACE_DIR/runtime/sources/frappe" ] || fail 'current workspace has no verifiable Frappe source snapshot'
  current_frappe=$(git -C "$WORKSPACE_DIR/runtime/sources/frappe" rev-parse HEAD) || fail 'cannot read current Frappe commit'
  current_docker=$(git -C "$WORKSPACE_DIR/runtime" rev-parse HEAD) || fail 'cannot read current Frappe Docker commit'
  target_parent=$(CDPATH= cd -- "$(dirname -- "$target_env")" && pwd)
  target_env="$target_parent/$(basename -- "$target_env")"
  target_name=$(basename -- "$target_env" .env)
  target_workspace="$target_parent/.frappeup/workspaces/$PROJECT_NAME-$target_name"
  [ ! -e "$target_workspace" ] || fail "target workspace already exists: $target_workspace"
  umask 077
  temp_target="$target_env.tmp.$$"
  trap 'rm -f "$temp_target"' EXIT HUP INT TERM
  {
    write_env_var PROFILE "$PROFILE"
    write_env_var PROJECT_NAME "$PROJECT_NAME"
    write_env_var SITE_NAME "$SITE_NAME"
    write_env_var WORKSPACE_DIR "$target_workspace"
    write_env_var FRAPPE_REPOSITORY "$FRAPPE_REPOSITORY"
    write_env_var FRAPPE_REF "$current_frappe"
    write_env_var FRAPPE_REF_KIND commit
    write_env_var FRAPPE_DOCKER_REPOSITORY "$FRAPPE_DOCKER_REPOSITORY"
    write_env_var FRAPPE_DOCKER_REF "$current_docker"
    write_env_var FRAPPE_DOCKER_REF_KIND commit
    write_env_var FRAPPE_MAJOR "$FRAPPE_MAJOR"
    write_env_var INSTALL_APPS "$INSTALL_APPS"
    if [ -n "${CUSTOM_APPS_FILE:-}" ]; then write_env_var CUSTOM_APPS_FILE "$CUSTOM_APPS_FILE"; fi
    for id in $PLAN_APPS; do
      current_app=$(git -C "$WORKSPACE_DIR/runtime/sources/apps/$id" rev-parse HEAD 2>/dev/null) || fail "cannot read current commit for $id"
      key=$(upper "$id")
      write_env_var "APP_${key}_REF" "$current_app"
      write_env_var "APP_${key}_REF_KIND" commit
    done
  } > "$temp_target"
  chmod 600 "$temp_target"
  mv "$temp_target" "$target_env"
  trap - EXIT HUP INT TERM
  printf 'Created %s\nEdit INSTALL_APPS or app refs, then run lock and workspace for this target profile.\n' "$target_env"
}

app_preflight() {
  [ -n "$CURRENT_ENV_FILE" ] || fail '--current-env-file is required for app updates'
  [ -n "$ENV_FILE" ] || fail '--env-file is required for app updates'
  target_env=$ENV_FILE
  current_info=$(ENV_FILE=$CURRENT_ENV_FILE; load_profile; printf '%s\n%s\n%s\n%s\n' "$PROJECT_NAME" "$SITE_NAME" "$PROFILE" "$WORKSPACE_DIR")
  CURRENT_PROJECT=$(printf '%s\n' "$current_info" | sed -n '1p')
  CURRENT_SITE=$(printf '%s\n' "$current_info" | sed -n '2p')
  CURRENT_PROFILE=$(printf '%s\n' "$current_info" | sed -n '3p')
  CURRENT_WORKSPACE=$(printf '%s\n' "$current_info" | sed -n '4p')
  ENV_FILE=$target_env
  load_profile; build_plan; load_lock
  [ "$PROFILE" = development ] && [ "$CURRENT_PROFILE" = development ] || fail 'app updates currently support development profiles only'
  [ "$PROJECT_NAME" = "$CURRENT_PROJECT" ] && [ "$SITE_NAME" = "$CURRENT_SITE" ] || fail 'current and target profiles must use the same project and site'
  [ -d "$CURRENT_WORKSPACE" ] && [ -d "$WORKSPACE_DIR" ] || fail 'both current and target workspaces must exist'
  CURRENT_WORKSPACE=$(CDPATH= cd -- "$CURRENT_WORKSPACE" && pwd -P)
  WORKSPACE_DIR=$(CDPATH= cd -- "$WORKSPACE_DIR" && pwd -P)
  [ "$CURRENT_WORKSPACE" != "$WORKSPACE_DIR" ] || fail 'target needs a separate WORKSPACE_DIR; preserve the current workspace'
  runtime="$WORKSPACE_DIR/runtime"
  [ -r "$runtime/images/custom/Containerfile" ] && [ -r "$runtime/apps.json" ] && [ -r "$WORKSPACE_DIR/workspace.env" ] && [ -r "$WORKSPACE_DIR/credentials.env" ] || fail 'target workspace is incomplete; run workspace for the target profile'
  [ -r "$CURRENT_WORKSPACE/credentials.env" ] && [ -r "$CURRENT_WORKSPACE/runtime/compose.yaml" ] || fail 'current workspace is incomplete'
  . "$WORKSPACE_DIR/workspace.env"
  [ "$WORKSPACE_PLAN_SHA256" = "$LOCK_PLAN_SHA256" ] || fail 'target workspace does not match its lock'
  current_frappe=$(git -C "$CURRENT_WORKSPACE/runtime/sources/frappe" rev-parse HEAD 2>/dev/null) || fail 'cannot verify current Frappe source commit'
  current_docker=$(git -C "$CURRENT_WORKSPACE/runtime" rev-parse HEAD 2>/dev/null) || fail 'cannot verify current Frappe Docker commit'
  [ "$current_frappe" = "$LOCK_FRAPPE_COMMIT" ] || fail 'Frappe core changed; this first app-update path supports app changes only'
  [ "$current_docker" = "$LOCK_FRAPPE_DOCKER_COMMIT" ] || fail 'Frappe Docker changed; pin its current commit for this app update'
  target_frappe=$(git -C "$WORKSPACE_DIR/runtime/sources/frappe" rev-parse HEAD 2>/dev/null) || fail 'cannot verify target Frappe source commit'
  target_docker=$(git -C "$WORKSPACE_DIR/runtime" rev-parse HEAD 2>/dev/null) || fail 'cannot verify target Frappe Docker source commit'
  [ "$target_frappe" = "$LOCK_FRAPPE_COMMIT" ] && [ "$target_docker" = "$LOCK_FRAPPE_DOCKER_COMMIT" ] || fail 'target source commits do not match the lock'
  [ -z "$(git -C "$WORKSPACE_DIR/runtime/sources/frappe" status --porcelain)" ] || fail 'target Frappe source has uncommitted changes'
  doctor_check
  backend_id=$(compose_at "$CURRENT_WORKSPACE" ps -q backend 2>/dev/null) || backend_id=''
  [ -n "$backend_id" ] || fail 'current backend is not running; no data was changed'
  owner=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$backend_id")
  config_files=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project.config_files"}}' "$backend_id")
  [ "$owner" = "$PROJECT_NAME" ] || fail 'current backend belongs to a different Compose project'
  case ",$config_files," in *",$CURRENT_WORKSPACE/runtime/compose.yaml,"*) :;; *) fail 'running backend was not created from the current workspace';; esac
  if [ -r "$CURRENT_WORKSPACE/runtime/.frappeup.env" ]; then current_runtime_env="$CURRENT_WORKSPACE/runtime/.frappeup.env"; else current_runtime_env="$CURRENT_WORKSPACE/runtime/.frappe1tap.env"; fi
  [ -r "$current_runtime_env" ] || fail 'current image metadata is missing'
  current_image=$(sed -n 's/^CUSTOM_IMAGE=//p' "$current_runtime_env")
  current_tag=$(sed -n 's/^CUSTOM_TAG=//p' "$current_runtime_env")
  actual_image=$(docker inspect --format '{{.Config.Image}}' "$backend_id")
  [ "$actual_image" = "$current_image:$current_tag" ] || fail 'running backend image does not match current workspace'
  inventory=$(compose_at "$CURRENT_WORKSPACE" exec -T backend bench --site "$SITE_NAME" list-apps) || fail 'cannot read current site app inventory'
  installed_names=$(printf '%s\n' "$inventory" | awk '$1 ~ /^[A-Za-z][A-Za-z0-9_]*$/ {print $1}' | tr '\n' ' ')
  contains_word "$installed_names" frappe || fail 'target is not a valid Frappe site'
  desired_names='frappe'
  NEW_APPS=''
  CHANGED_APPS=''
  for id in $PLAN_APPS; do
    app=$(app_field "$id" APP_NAME)
    valid_app_id "$app" || fail "invalid app package name: $app"
    desired_names="$desired_names $app"
    eval "target_commit=\${LOCK_APP_${id}_COMMIT-}"
    [ -n "${target_commit:-}" ] || fail "target lock lacks app $id"
    target_source="$WORKSPACE_DIR/runtime/sources/apps/$id"
    target_head=$(git -C "$target_source" rev-parse HEAD 2>/dev/null) || fail "cannot verify target source for $app"
    [ "$target_head" = "$target_commit" ] || fail "target source for $app does not match the lock"
    [ -z "$(git -C "$target_source" status --porcelain)" ] || fail "target source for $app has uncommitted changes"
    if contains_word "$installed_names" "$app"; then
      [ -d "$CURRENT_WORKSPACE/runtime/sources/apps/$id" ] || fail "cannot verify current source for installed app $app"
      current_commit=$(git -C "$CURRENT_WORKSPACE/runtime/sources/apps/$id" rev-parse HEAD 2>/dev/null) || fail "cannot verify current commit for $app"
      if [ "$current_commit" != "$target_commit" ]; then
        git -C "$target_source" merge-base --is-ancestor "$current_commit" "$target_commit" || fail "app $app target is not a forward update; downgrades and branch switches need a separate workflow"
        CHANGED_APPS="$CHANGED_APPS $app"
      fi
    else
      NEW_APPS="$NEW_APPS $app"
    fi
  done
  for app in $installed_names; do contains_word "$desired_names" "$app" || fail "target omits installed app $app; app removal is not supported"; done
  NEW_APPS=$(printf '%s\n' "$NEW_APPS" | awk '{$1=$1; print}')
  CHANGED_APPS=$(printf '%s\n' "$CHANGED_APPS" | awk '{$1=$1; print}')
  printf 'Project: %s\nSite: %s\nCurrent image: %s\nTarget lock: %s\nNew apps: %s\nUpdated apps: %s\n' "$PROJECT_NAME" "$SITE_NAME" "$actual_image" "$LOCK_PLAN_SHA256" "${NEW_APPS:-none}" "${CHANGED_APPS:-none}"
  printf 'The app update takes a full backup, pauses application services, migrates the preserved site, then verifies service and site health. Writes and web requests will be unavailable during migration.\n'
}

app_apply_cleanup() {
  result=$?
  if [ "$result" -ne 0 ]; then app_phase failed; fi
  if [ "$result" -ne 0 ] && [ "${APP_SERVICES_PAUSED:-false}" = true ] && [ "${APP_MIGRATION_STARTED:-false}" = false ]; then
    compose_at "$CURRENT_WORKSPACE" up -d --no-deps backend frontend websocket queue-short queue-long scheduler >/dev/null 2>&1 || printf 'Could not restart the original services; inspect Docker logs.\n' >&2
  fi
  if [ "${APP_MUTATION_STARTED:-false}" = true ] && [ "$result" -ne 0 ]; then
    printf 'Update stopped after the backup checkpoint. Site data may have changed; do not roll back the image alone. Backup: %s\n' "$backup_dir" >&2
    printf 'Inspect Docker logs and restore the matching backup in an isolated project before deciding recovery.\n' >&2
  fi
  [ -z "${APP_LOCK_DIR:-}" ] || rmdir "$APP_LOCK_DIR" 2>/dev/null || :
}
app_phase() {
  [ -n "${APP_OPERATION_FILE:-}" ] || return 0
  printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >> "$APP_OPERATION_FILE"
}

app_apply() {
  app_preflight
  if [ -z "$NEW_APPS" ] && [ -z "$CHANGED_APPS" ]; then printf 'Site already matches the target app commits; no change made.\n'; return 0; fi
  if [ "$YES" != true ]; then
    [ -t 0 ] || fail 'app apply requires an interactive confirmation or --yes'
    printf 'Type APPLY %s to continue: ' "$PROJECT_NAME" >&2
    IFS= read -r confirmation || confirmation=''
    [ "$confirmation" = "APPLY $PROJECT_NAME" ] || fail 'app update cancelled; no data was changed'
  fi
  mkdir -p "$ROOT_DIR/.frappeup/locks"
  APP_LOCK_DIR="$ROOT_DIR/.frappeup/locks/$PROJECT_NAME.lock"
  mkdir "$APP_LOCK_DIR" 2>/dev/null || fail "another app update may be active: $APP_LOCK_DIR"
  APP_MUTATION_STARTED=false
  APP_SERVICES_PAUSED=false
  APP_MIGRATION_STARTED=false
  trap 'app_apply_cleanup' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  umask 077
  mkdir -p "$CURRENT_WORKSPACE/.frappeup-operations"
  APP_OPERATION_FILE="$CURRENT_WORKSPACE/.frappeup-operations/update-$(date -u '+%Y%m%d_%H%M%S')-$$.log"
  app_phase acquired
  cp "$CURRENT_WORKSPACE/credentials.env" "$WORKSPACE_DIR/credentials.env"
  build_runtime_image
  for endpoint_key in HTTP_PUBLISH_PORT NGINX_LISTEN_PORT; do
    endpoint_value=$(sed -n "s/^${endpoint_key}=//p" "$current_runtime_env")
    if [ -n "$endpoint_value" ]; then printf '%s=%s\n' "$endpoint_key" "$endpoint_value" >> "$runtime/.frappeup.env"; fi
  done
  image_id=$(docker image inspect --format '{{.Id}}' "$image:$tag") || fail 'built image is unavailable'
  app_phase "built $image_id"
  compose_at "$WORKSPACE_DIR" config -q
  APP_SERVICES_PAUSED=true
  compose_at "$CURRENT_WORKSPACE" stop frontend websocket queue-short queue-long scheduler
  app_phase writes_paused
  backup_site "$CURRENT_WORKSPACE" update
  app_phase "backup $backup_dir"
  printf 'Backup checkpoint: %s\n' "$backup_dir"
  log_event "app.update.backup $PROJECT_NAME $backup_dir"
  APP_MUTATION_STARTED=true
  compose_at "$CURRENT_WORKSPACE" stop backend
  app_phase services_stopped
  migration_script='set -e; ls -1 apps > sites/apps.txt;'
  for app in $NEW_APPS; do migration_script="$migration_script bench --site $SITE_NAME install-app $app;"; done
  migration_script="$migration_script bench --site $SITE_NAME migrate;"
  APP_MIGRATION_STARTED=true
  compose_at "$WORKSPACE_DIR" run --rm --no-deps backend bash -lc "$migration_script"
  app_phase migrated
  compose_at "$WORKSPACE_DIR" up -d --no-deps backend websocket queue-short queue-long scheduler frontend
  app_phase services_started
  for service in backend websocket queue-short queue-long scheduler frontend; do
    attempt=0
    while [ -z "$(compose_at "$WORKSPACE_DIR" ps --status running -q "$service" 2>/dev/null)" ]; do
      attempt=$((attempt+1)); [ "$attempt" -lt 30 ] || fail "$service did not become running"
      sleep 2
    done
  done
  verified=$(compose_at "$WORKSPACE_DIR" exec -T backend bench --site "$SITE_NAME" list-apps) || fail 'updated site inventory is unavailable'
  for app in $desired_names; do printf '%s\n' "$verified" | awk '{print $1}' | grep -Fx "$app" >/dev/null || fail "updated site lacks app $app"; done
  compose_at "$WORKSPACE_DIR" exec -T backend python -c 'import requests,sys; r=requests.get("http://frontend:8080",headers={"Host":sys.argv[1]},timeout=30); print("HTTP",r.status_code); sys.exit(0 if r.status_code in (200,302,303) else 1)' "$SITE_NAME" || fail 'updated site HTTP health check failed'
  APP_MUTATION_STARTED=false
  APP_SERVICES_PAUSED=false
  app_phase verified
  log_event "app.update.completed $PROJECT_NAME $image_id"
  printf 'Updated %s with image %s:%s; data volumes were preserved.\nBackup: %s\nOperation log: %s\n' "$SITE_NAME" "$image" "$tag" "$backup_dir" "$APP_OPERATION_FILE"
}

app_command() {
  [ "$#" -gt 0 ] || fail 'usage: frappeup app prepare|plan|apply --current-env-file CURRENT --env-file TARGET'
  action=$1; shift; parse_common "$@"
  case "$action" in prepare) app_prepare;; plan) app_preflight;; apply) app_apply;; *) fail 'usage: frappeup app prepare|plan|apply --current-env-file CURRENT --env-file TARGET';; esac
}
backup_command() {
  load_profile
  doctor_check
  backup_site "$WORKSPACE_DIR" manual
  log_event "backup.completed $PROJECT_NAME $backup_dir"
  printf 'Backup: %s\n' "$backup_dir"
}
backup_verify() {
  [ -n "$BACKUP_DIR" ] && [ -d "$BACKUP_DIR" ] || fail '--backup-dir must name an existing backup directory'
  BACKUP_DIR=$(CDPATH= cd -- "$BACKUP_DIR" && pwd -P)
  [ -r "$BACKUP_DIR/manifest.env" ] && [ -r "$BACKUP_DIR/SHA256SUMS" ] || fail 'backup manifest or checksums are missing'
  count=0
  while read -r expected filename; do
    case "$expected" in *[!0-9a-f]*|'') fail 'invalid backup checksum';; esac
    [ "${#expected}" -eq 64 ] || fail 'invalid backup checksum'
    case "$filename" in ''|*/*|*'..'*) fail 'invalid backup artifact name';; esac
    [ -f "$BACKUP_DIR/$filename" ] || fail "backup artifact is missing: $filename"
    [ "$(sha256 < "$BACKUP_DIR/$filename")" = "$expected" ] || fail "backup checksum mismatch: $filename"
    count=$((count+1))
  done < "$BACKUP_DIR/SHA256SUMS"
  [ "$count" -eq 4 ] || fail 'backup must contain four checksummed artifacts'
  database_archive=$(find "$BACKUP_DIR" -maxdepth 1 -type f -name '*-database*.sql.gz' -print -quit)
  public_archive=$(find "$BACKUP_DIR" -maxdepth 1 -type f -name '*-files.tgz' ! -name '*-private-files.tgz' -print -quit)
  private_archive=$(find "$BACKUP_DIR" -maxdepth 1 -type f -name '*-private-files.tgz' -print -quit)
  config_backup=$(find "$BACKUP_DIR" -maxdepth 1 -type f -name '*-site_config_backup.json' -print -quit)
  [ -n "$database_archive" ] && [ -n "$public_archive" ] && [ -n "$private_archive" ] && [ -n "$config_backup" ] || fail 'backup archive set is incomplete'
  gzip -t "$database_archive" && tar -tzf "$public_archive" >/dev/null && tar -tzf "$private_archive" >/dev/null || fail 'backup archive integrity check failed'
  printf 'PASS backup checksums and archive integrity: %s\n' "$BACKUP_DIR"
}
backup_manifest_field() {
  field=$1
  sed -n "s/^${field}='\([^']*\)'$/\1/p" "$BACKUP_DIR/manifest.env"
}
restore_cleanup() {
  result=$?
  if [ "${RESTORE_STARTED:-false}" = true ] && [ "$result" -ne 0 ]; then
    printf 'Restore stopped after changing the project. Inspect operation log and Docker logs; do not start an unverified image.\n' >&2
  fi
  [ -z "${RESTORE_LOCK_DIR:-}" ] || rmdir "$RESTORE_LOCK_DIR" 2>/dev/null || :
}
restore_command() {
  load_profile; build_plan; backup_verify
  [ "$PROFILE" = development ] || fail 'restore currently supports development profiles only'
  [ "$(backup_manifest_field BACKUP_PROJECT)" = "$PROJECT_NAME" ] && [ "$(backup_manifest_field BACKUP_SITE)" = "$SITE_NAME" ] || fail 'backup belongs to a different project or site'
  if [ -r "$WORKSPACE_DIR/runtime/.frappeup.env" ]; then runtime_env="$WORKSPACE_DIR/runtime/.frappeup.env"; else runtime_env="$WORKSPACE_DIR/runtime/.frappe1tap.env"; fi
  [ -r "$runtime_env" ] && [ -r "$WORKSPACE_DIR/credentials.env" ] || fail 'restore workspace is incomplete'
  restore_image="$(sed -n 's/^CUSTOM_IMAGE=//p' "$runtime_env"):$(sed -n 's/^CUSTOM_TAG=//p' "$runtime_env")"
  [ "$(backup_manifest_field BACKUP_IMAGE)" = "$restore_image" ] || fail 'backup image does not match restore profile; use the profile and image from the backup checkpoint'
  doctor_check
  docker image inspect "$restore_image" >/dev/null 2>&1 || fail "restore image is unavailable: $restore_image"
  project_resources || fail 'Docker project has no existing state to restore'
  printf '%s\n' "$volume_names" | grep -Fx "${PROJECT_NAME}_sites" >/dev/null || fail 'site volume is missing; refusing to create a new site during restore'
  if [ "$YES" != true ]; then
    [ -t 0 ] || fail 'restore requires an interactive confirmation or --yes'
    printf 'Type RESTORE %s to overwrite site data from %s: ' "$PROJECT_NAME" "$BACKUP_DIR" >&2
    IFS= read -r confirmation || confirmation=''
    [ "$confirmation" = "RESTORE $PROJECT_NAME" ] || fail 'restore cancelled; no data was changed'
  fi
  mkdir -p "$ROOT_DIR/.frappeup/locks"
  RESTORE_LOCK_DIR="$ROOT_DIR/.frappeup/locks/$PROJECT_NAME.lock"
  mkdir "$RESTORE_LOCK_DIR" 2>/dev/null || fail "another operation may be active: $RESTORE_LOCK_DIR"
  RESTORE_STARTED=false
  trap 'restore_cleanup' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  umask 077
  restore_override="$WORKSPACE_DIR/frappeup.restore.yaml"
  cat > "$restore_override" <<'RESTORE_YAML'
services:
  backend:
    environment:
      FRAPPEUP_DB_PASSWORD: ${DB_PASSWORD}
RESTORE_YAML
  compose_at "$WORKSPACE_DIR" config -q
  RESTORE_STARTED=true
  compose_at "$WORKSPACE_DIR" stop frontend backend websocket queue-short queue-long scheduler
  compose_at "$WORKSPACE_DIR" up -d db redis-cache redis-queue
  restore_script="set -e; ls -1 apps > sites/apps.txt; bench --site $SITE_NAME restore /restore/$(basename -- "$database_archive") --with-public-files /restore/$(basename -- "$public_archive") --with-private-files /restore/$(basename -- "$private_archive") --db-root-password=\$FRAPPEUP_DB_PASSWORD --force"
  COMPOSE_EXTRA_FILE="$restore_override" compose_at "$WORKSPACE_DIR" run --rm --no-deps -v "$BACKUP_DIR:/restore:ro" backend bash -lc "$restore_script"
  compose_at "$WORKSPACE_DIR" up -d --no-deps backend websocket queue-short queue-long scheduler frontend
  verified=$(compose_at "$WORKSPACE_DIR" exec -T backend bench --site "$SITE_NAME" list-apps) || fail 'restored site inventory is unavailable'
  for id in $PLAN_APPS; do app=$(app_field "$id" APP_NAME); printf '%s\n' "$verified" | awk '{print $1}' | grep -Fx "$app" >/dev/null || fail "restored site lacks app $app"; done
  compose_at "$WORKSPACE_DIR" exec -T backend python -c 'import requests,sys; r=requests.get("http://frontend:8080",headers={"Host":sys.argv[1]},timeout=30); print("HTTP",r.status_code); sys.exit(0 if r.status_code in (200,302,303) else 1)' "$SITE_NAME" || fail 'restored site HTTP health check failed'
  RESTORE_STARTED=false
  log_event "restore.completed $PROJECT_NAME $BACKUP_DIR"
  printf 'Restored %s from %s with %s\n' "$SITE_NAME" "$BACKUP_DIR" "$restore_image"
}

doctor_check() {
  require_command docker
  docker version --format '{{.Server.Version}}' >/dev/null 2>&1 || fail 'Docker daemon is not ready'
  docker compose version >/dev/null 2>&1 || fail 'Docker Compose is required'
  docker buildx version >/dev/null 2>&1 || fail 'Docker Buildx is required'
}

doctor_command() { [ -n "$ENV_FILE" ] && load_profile || LOG_DIR="$(pwd)/.frappeup/logs"; doctor_check; printf 'PASS Docker CLI, Docker Compose, Buildx, and daemon\n'; log_event 'doctor.completed'; }

credentials_command() {
  load_profile
  credentials="$WORKSPACE_DIR/credentials.env"
  [ -r "$credentials" ] || fail "initial credentials are missing: $credentials"
  [ "$(grep -c '^ADMIN_PASSWORD=' "$credentials")" -eq 1 ] || fail 'initial Administrator password is missing or ambiguous'
  password=$(sed -n 's/^ADMIN_PASSWORD=//p' "$credentials")
  [ -n "$password" ] || fail 'initial Administrator password is empty'
  printf 'Login: Administrator\nInitial password: %s\n' "$password"
}

init_command() {
  profile=development
  while [ "$#" -gt 0 ]; do case "$1" in --profile) [ "$#" -gt 1 ] || fail '--profile needs a value'; profile=$2; shift 2;; --env-file) [ "$#" -gt 1 ] || fail '--env-file needs a path'; ENV_FILE=$2; shift 2;; --force) FORCE=true; shift;; *) fail "unknown option: $1";; esac; done
  case "$profile" in development|production) :;; *) fail '--profile must be development or production';; esac
  [ -n "$ENV_FILE" ] || ENV_FILE="frappeup.$profile.env"
  [ ! -e "$ENV_FILE" ] || [ "$FORCE" = true ] || fail "$ENV_FILE already exists; use --force"
  case "$profile" in development) project=frappeup-dev; site=site.localhost;; production) project=frappeup-prod; site=site.example.com;; esac
  cat > "$ENV_FILE" <<EOF2
PROFILE=$profile
PROJECT_NAME=$project
SITE_NAME=$site
FRAPPE_REPOSITORY=https://github.com/frappe/frappe
FRAPPE_REF=version-16
FRAPPE_REF_KIND=branch
FRAPPE_DOCKER_REPOSITORY=https://github.com/frappe/frappe_docker
FRAPPE_DOCKER_REF=main
FRAPPE_DOCKER_REF_KIND=branch
FRAPPE_MAJOR=16
INSTALL_APPS=erpnext
# Override an official app version: APP_ERPNEXT_REF=version-16
# Add third-party app definitions: CUSTOM_APPS_FILE=custom-apps.env
EOF2
  chmod 600 "$ENV_FILE"; printf 'Created %s\n' "$ENV_FILE"
}

plan_command() { load_profile; build_plan; printf 'Profile: %s\nProject: %s\nSite: %s\nFrappe: %s @ %s\nFrappe Docker: %s @ %s\nApps (install order):\n' "$PROFILE" "$PROJECT_NAME" "$SITE_NAME" "$FRAPPE_REPOSITORY" "$FRAPPE_REF" "$FRAPPE_DOCKER_REPOSITORY" "$FRAPPE_DOCKER_REF"; for id in $PLAN_APPS; do printf '  - %s [%s] @ %s\n' "$id" "$(effective_ref_kind "$id")" "$(effective_ref "$id")"; done; }

lock_command() {
  load_profile; build_plan
  [ -n "$LOCK_FILE" ] || LOCK_FILE="$ENV_FILE.lock.env"
  [ ! -e "$LOCK_FILE" ] || [ "$FORCE" = true ] || fail "$LOCK_FILE already exists; use --force"
  mkdir -p "$(dirname -- "$LOCK_FILE")"; umask 077
  temp_lock="$LOCK_FILE.tmp.$$"
  trap 'rm -f "$temp_lock"' EXIT HUP INT TERM
  frappe_commit=$(resolve_commit "$FRAPPE_REPOSITORY" "$FRAPPE_REF" "$FRAPPE_REF_KIND")
  docker_commit=$(resolve_commit "$FRAPPE_DOCKER_REPOSITORY" "$FRAPPE_DOCKER_REF" "$FRAPPE_DOCKER_REF_KIND")
  {
    write_env_var LOCK_SCHEMA 2
    write_env_var LOCK_PLAN_SHA256 "$(plan_checksum)"
    write_env_var LOCK_PROJECT_NAME "$PROJECT_NAME"
    write_env_var LOCK_SITE_NAME "$SITE_NAME"
    write_env_var LOCK_FRAPPE_REPOSITORY "$FRAPPE_REPOSITORY"; write_env_var LOCK_FRAPPE_REF "$FRAPPE_REF"; write_env_var LOCK_FRAPPE_REF_KIND "$FRAPPE_REF_KIND"; write_env_var LOCK_FRAPPE_COMMIT "$frappe_commit"
    write_env_var LOCK_FRAPPE_DOCKER_REPOSITORY "$FRAPPE_DOCKER_REPOSITORY"; write_env_var LOCK_FRAPPE_DOCKER_REF "$FRAPPE_DOCKER_REF"; write_env_var LOCK_FRAPPE_DOCKER_REF_KIND "$FRAPPE_DOCKER_REF_KIND"; write_env_var LOCK_FRAPPE_DOCKER_COMMIT "$docker_commit"
    write_env_var LOCK_APP_IDS "$PLAN_APPS"
    for id in $PLAN_APPS; do
      app_commit=$(resolve_commit "$(app_field "$id" REPOSITORY)" "$(effective_ref "$id")" "$(effective_ref_kind "$id")")
      write_env_var "LOCK_APP_${id}_REPOSITORY" "$(app_field "$id" REPOSITORY)"
      write_env_var "LOCK_APP_${id}_REF" "$(effective_ref "$id")"
      write_env_var "LOCK_APP_${id}_REF_KIND" "$(effective_ref_kind "$id")"
      write_env_var "LOCK_APP_${id}_APP_NAME" "$(app_field "$id" APP_NAME)"
      write_env_var "LOCK_APP_${id}_COMMIT" "$app_commit"
    done
  } > "$temp_lock"
  chmod 600 "$temp_lock"; mv "$temp_lock" "$LOCK_FILE"; trap - EXIT HUP INT TERM
  log_event 'lock.completed'; printf 'Created %s\n' "$LOCK_FILE"
}

status_command() { load_profile; runtime="$WORKSPACE_DIR/runtime"; compose_runtime ps; }
logs_command() {
  load_profile
  if [ "$DOCKER_LOGS" = true ]; then
    runtime="$WORKSPACE_DIR/runtime"
    if [ "$FOLLOW" = true ]; then compose_runtime logs --tail "$LINES" --follow
    else compose_runtime logs --tail "$LINES"; fi
  else
    logfile="$LOG_DIR/cli.log"
    [ -r "$logfile" ] || return 0
    if [ "$FOLLOW" = true ]; then tail -n "$LINES" -f "$logfile"
    else tail -n "$LINES" "$logfile"; fi
  fi
}
catalog_command() { [ "${1:-}" = list ] && [ "$#" -eq 1 ] || fail 'usage: frappeup catalog list'; for id in $APP_IDS; do printf '%-24s %-28s %s @ %s\n' "$id" "$(app_field "$id" DISPLAY_NAME)" "$(app_field "$id" REF_KIND)" "$(app_field "$id" REF)"; done; }

[ "$#" -gt 0 ] || { usage; exit 0; }
command=$1; shift
case "$command" in
  help|--help|-h) usage ;;
  version|--version) printf '%s\n' "$VERSION" ;;
  init) init_command "$@" ;;
  catalog) catalog_command "$@" ;;
  plan) parse_common "$@"; plan_command ;;
  lock) parse_common "$@"; lock_command ;;
  workspace) parse_common "$@"; workspace_command ;;
  install) parse_common "$@"; install_command ;;
  app) app_command "$@" ;;
  backup) if [ "${1:-}" = verify ]; then shift; parse_common "$@"; backup_verify; else parse_common "$@"; backup_command; fi ;;
  restore) parse_common "$@"; restore_command ;;
  credentials) parse_common "$@"; credentials_command ;;
  status) parse_common "$@"; status_command ;;
  logs) parse_common "$@"; logs_command ;;
  doctor) parse_common "$@"; doctor_command ;;
  *) fail "unknown command $command; run frappeup help" ;;
esac
