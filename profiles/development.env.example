# Development profile: branches are allowed and resolved when you create a lock.
PROFILE=development
PROJECT_NAME=frappeup-dev
SITE_NAME=site.localhost
FRAPPE_REPOSITORY=https://github.com/frappe/frappe
FRAPPE_REF=version-16
FRAPPE_REF_KIND=branch
FRAPPE_DOCKER_REPOSITORY=https://github.com/frappe/frappe_docker
FRAPPE_DOCKER_REF=main
FRAPPE_DOCKER_REF_KIND=branch
FRAPPE_MAJOR=16
INSTALL_APPS=erpnext,hrms
# CUSTOM_APPS_FILE=custom-apps.env
# WORKSPACE_DIR=.frappeup/workspaces/frappeup-dev
